{
  "$defs": {
    "Cache": {
      "additionalProperties": false,
      "properties": {
        "export_sidecars": {
          "default": false,
          "type": "boolean"
        },
        "import_sidecars": {
          "default": false,
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/$defs/CacheMode",
          "default": "reuse"
        },
        "validation": {
          "$ref": "#/$defs/Validation",
          "default": "fast"
        }
      },
      "type": "object"
    },
    "CacheMode": {
      "enum": [
        "reuse",
        "refresh"
      ],
      "type": "string"
    },
    "ExactDuplicates": {
      "enum": [
        "reuse_known",
        "compute",
        "off"
      ],
      "type": "string"
    },
    "Filters": {
      "additionalProperties": false,
      "properties": {
        "exclude_globs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "extensions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "include_globs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "include_hidden": {
          "default": true,
          "type": "boolean"
        },
        "max_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "min_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "download_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "download_bytes_per_second": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "inference_workers": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "io_workers": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "memory_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "result_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "staging_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "wall_time_seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Matching": {
      "additionalProperties": false,
      "properties": {
        "grouping": {
          "default": "all_pairs",
          "type": "string"
        },
        "retrieval": {
          "default": "exact",
          "type": "string"
        },
        "score_retention": {
          "$ref": "#/$defs/ScoreRetention",
          "default": "matches"
        },
        "threshold_overrides": {
          "additionalProperties": {
            "format": "double",
            "type": "number"
          },
          "default": {},
          "type": "object"
        }
      },
      "type": "object"
    },
    "Operation": {
      "enum": [
        "scan",
        "index",
        "compare",
        "group"
      ],
      "type": "string"
    },
    "PairScope": {
      "enum": [
        "all_selected",
        "within_each_source"
      ],
      "type": "string"
    },
    "RawPath": {
      "additionalProperties": false,
      "properties": {
        "base64": {
          "type": "string"
        },
        "encoding": {
          "type": "string"
        }
      },
      "required": [
        "encoding",
        "base64"
      ],
      "type": "object"
    },
    "ScoreRetention": {
      "enum": [
        "matches",
        "all"
      ],
      "type": "string"
    },
    "Source": {
      "additionalProperties": false,
      "oneOf": [
        {
          "not": {
            "required": [
              "local_path"
            ]
          },
          "properties": {
            "root": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "root"
          ]
        },
        {
          "not": {
            "required": [
              "root"
            ]
          },
          "properties": {
            "local_path": {
              "type": "object"
            }
          },
          "required": [
            "local_path"
          ]
        }
      ],
      "properties": {
        "connection_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "local_path": {
          "anyOf": [
            {
              "$ref": "#/$defs/RawPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "type": "string"
        },
        "root": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "provider"
      ],
      "type": "object"
    },
    "Validation": {
      "enum": [
        "fast",
        "strict"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "sources": {
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "sources"
        ]
      },
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "compare",
              "group"
            ]
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "allOf": [
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "sources"
                  ]
                },
                {
                  "required": [
                    "families"
                  ]
                },
                {
                  "required": [
                    "profiles"
                  ]
                },
                {
                  "required": [
                    "filters"
                  ]
                },
                {
                  "required": [
                    "cache"
                  ]
                },
                {
                  "required": [
                    "recursive"
                  ]
                },
                {
                  "required": [
                    "exact_duplicates"
                  ]
                }
              ]
            }
          }
        ],
        "properties": {
          "limits": {
            "properties": {
              "download_bytes": false,
              "download_bytes_per_second": false,
              "inference_workers": false,
              "io_workers": false,
              "staging_bytes": false
            }
          }
        }
      }
    },
    {
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "snapshot_id"
              ]
            }
          ]
        }
      },
      "if": {
        "properties": {
          "operation": {
            "const": "compare"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "snapshot_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "snapshot_id"
        ]
      }
    },
    {
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "source_run_id"
              ]
            },
            {
              "required": [
                "source_revision"
              ]
            }
          ]
        }
      },
      "if": {
        "properties": {
          "operation": {
            "const": "group"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "source_revision": {
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "source_run_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "source_run_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "index"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "matching"
              ]
            },
            {
              "required": [
                "pair_scope"
              ]
            }
          ]
        }
      }
    }
  ],
  "properties": {
    "cache": {
      "anyOf": [
        {
          "$ref": "#/$defs/Cache"
        },
        {
          "type": "null"
        }
      ]
    },
    "exact_duplicates": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactDuplicates"
        },
        {
          "type": "null"
        }
      ]
    },
    "families": {
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "filters": {
      "anyOf": [
        {
          "$ref": "#/$defs/Filters"
        },
        {
          "type": "null"
        }
      ]
    },
    "limits": {
      "anyOf": [
        {
          "$ref": "#/$defs/Limits"
        },
        {
          "type": "null"
        }
      ]
    },
    "matching": {
      "anyOf": [
        {
          "$ref": "#/$defs/Matching"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation": {
      "$ref": "#/$defs/Operation",
      "default": "scan"
    },
    "pair_scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/PairScope"
        },
        {
          "type": "null"
        }
      ]
    },
    "profiles": {
      "additionalProperties": {
        "type": "string"
      },
      "type": [
        "object",
        "null"
      ]
    },
    "recursive": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_revision": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "source_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "type": [
        "array",
        "null"
      ]
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "JobRequest",
  "type": "object"
}
