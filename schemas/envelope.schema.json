{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data": {
      "type": "object"
    },
    "invocation_id": {
      "type": "string"
    },
    "job_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_id": {
      "type": "string"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "sequence": {
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "type": {
      "enum": [
        "accepted",
        "progress",
        "error",
        "summary",
        "status",
        "page",
        "export",
        "profiles",
        "capabilities"
      ]
    }
  },
  "required": [
    "schema_version",
    "invocation_id",
    "request_id",
    "sequence",
    "type",
    "data"
  ],
  "title": "Envelope",
  "type": "object"
}
