{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A bounded rectangular view of a saved score run. Offsets are zero-based and\nboth axes follow immutable snapshot file order (file_id order).",
  "properties": {
    "column_limit": {
      "default": 128,
      "format": "uint32",
      "maximum": 256,
      "minimum": 1,
      "type": "integer"
    },
    "column_offset": {
      "default": 0,
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "result_revision": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "row_limit": {
      "default": 128,
      "format": "uint32",
      "maximum": 256,
      "minimum": 1,
      "type": "integer"
    },
    "row_offset": {
      "default": 0,
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "run_id": {
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "run_id"
  ],
  "title": "MatrixQuery",
  "type": "object"
}
