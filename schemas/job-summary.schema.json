{
  "$defs": {
    "Completeness": {
      "properties": {
        "comparison_coverage": {
          "type": "string"
        },
        "freshness": {
          "type": "string"
        },
        "limits_reached": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "retrieval_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_coverage": {
          "type": "string"
        }
      },
      "required": [
        "source_coverage",
        "comparison_coverage",
        "limits_reached",
        "freshness"
      ],
      "type": "object"
    },
    "Counts": {
      "properties": {
        "bytes_hashed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "bytes_read": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "cache_hits": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "exact_pairs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "files_discovered": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "files_excluded": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "files_failed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "files_ready": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "groups": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "locations": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "pairs_compared": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "similar_pairs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "vectors_encoded": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "files_discovered",
        "files_ready",
        "files_failed",
        "files_excluded",
        "locations",
        "vectors_encoded",
        "cache_hits",
        "bytes_read",
        "bytes_hashed",
        "pairs_compared",
        "similar_pairs",
        "groups",
        "exact_pairs"
      ],
      "type": "object"
    },
    "Error": {
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "details": true,
        "fatal": {
          "type": "boolean"
        },
        "file_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "stage": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "stage",
        "retryable",
        "fatal",
        "message",
        "details"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "invalid_request",
        "unsupported_schema_version",
        "unsupported_provider",
        "unsupported_capability",
        "experimental_profile_required",
        "unknown_profile",
        "threshold_required",
        "cache_busy",
        "engine_busy",
        "not_found",
        "invalid_cursor",
        "results_not_ready",
        "database_version_unsupported",
        "database_corrupt",
        "storage_error",
        "io_error",
        "resource_budget_too_small",
        "budget_exhausted",
        "source_changed",
        "unsupported_format",
        "unselected_family",
        "invalid_text",
        "insufficient_content",
        "runtime_unavailable",
        "model_integrity",
        "decode_failed",
        "worker_failed",
        "worker_timeout",
        "strict_consistency_unavailable",
        "result_expired",
        "record_too_large",
        "output_closed",
        "cancelled",
        "internal_error"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "attempt_id": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "completeness": {
      "$ref": "#/$defs/Completeness"
    },
    "counts": {
      "$ref": "#/$defs/Counts"
    },
    "elapsed_seconds": {
      "format": "double",
      "type": "number"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/Error"
        },
        {
          "type": "null"
        }
      ]
    },
    "finished_at": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "result_bytes_used": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "result_revision": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "resumable": {
      "type": "boolean"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope_summary": true,
    "snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": "string"
    },
    "status": {
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "attempt_id",
    "status",
    "resumable",
    "scope_summary",
    "started_at",
    "finished_at",
    "elapsed_seconds",
    "result_bytes_used",
    "counts",
    "completeness"
  ],
  "title": "JobSummary",
  "type": "object"
}
